# Copy to .env for local dev. In production these come from Cloud Run env vars
# and Secret Manager (see .github/workflows/deploy.yaml).

# Required
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/binarygarden

# Comma-separated user ids allowed to register OAuth clients (see /account)
ADMIN_USER_IDS=

# Email (unset in dev: verification/reset links are printed to the console)
RESEND_API_KEY=
EMAIL_FROM="Binary Garden <auth@binarygarden.com>"

# Social sign-in: a provider only shows up when its client id is set.
# Callback URL for each: $BETTER_AUTH_URL/api/auth/callback/<github|google|apple>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple needs HTTPS (no localhost) and an Apple Developer account
APPLE_CLIENT_ID=               # Services ID
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=             # contents of the .p8 key; \n escapes are fine
